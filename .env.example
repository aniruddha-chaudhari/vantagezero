DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
BRIGHTDATA_API_KEY="your-bright-data-api-key"
# Bright Data zone name used for SERP (live part search). `bdata zones` lists yours.
BRIGHTDATA_SERP_ZONE="your-serp-or-unlocker-zone"
INGEST_API_TOKEN="a-long-random-string-you-generate"

# Powers the "Help me choose parts" guided BOM flow (/dashboard/new). Optional - that flow
# shows a clear "not configured" message if this is missing, everything else works without it.
GROQ_API_KEY="your-groq-api-key"
# Optional override if the default model is retired/renamed.
GROQ_MODEL="openai/gpt-oss-120b"

# Optional. Slack Incoming Webhook for scraper incidents, heal escalations and critical
# buildability alerts. Unset no-ops every Slack call - nothing else changes.
SLACK_WEBHOOK_URL=""
# Optional. Set to 1 to ALSO post one line per successful scrape (a live activity feed).
# Leave unset for cron collection and bulk backfills: an `ingest.ts --all` cycle would post
# one per enabled source target and Slack rate-limits that burst.
SLACK_ACTIVITY_FEED=""
