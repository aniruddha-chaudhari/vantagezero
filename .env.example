DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
BRIGHTDATA_API_KEY="your-bright-data-api-key"
INGEST_API_TOKEN="a-long-random-string-you-generate"

# Powers the "Help me choose parts" guided BOM flow (/dashboard/new). Optional - that flow
# shows a clear "not configured" message if this is missing, everything else works without it.
GROQ_API_KEY="your-groq-api-key"
# Optional override if the default model is retired/renamed.
GROQ_MODEL="openai/gpt-oss-120b"
